# https://openchargealliance.org/download-ocpp/ 에서 무료로 받을 수 있다.
docs/spec/

# Gradle / JVM
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
*.class

# 로컬 개발 도구의 실행 증거와 설정 — 저장소의 계약이 아니다.
# 완료의 정의는 .github/workflows/ci.yml 의 게이트 여섯 개다.
.zannabi/
.zannabi.json

# H2 — OUT_TIMED_OUT 장부 (PLAN §5.3). 런타임 데이터라 저장소에 넣지 않는다.
data/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# Kotlin 2.x 빌드 세션
.kotlin/

# 중첩 실행이 만든 로컬 권한 설정
.claude/settings.local.json

# 테스트 JVM 부산물
.attach_pid*

# 저장소에 올리지 않는 작업 메모 (지원 전략·JD 대응 등). notes/README.md 참조.
# ⚠️ 한 번 커밋되면 히스토리에 남는다. 여기 있는 것을 docs/ 로 옮기지 않는다.
notes/

# npm — 화면 빌드 체인 (sim-console/ui). 산출물과 의존성은 저장소에 넣지 않는다.
node_modules/
